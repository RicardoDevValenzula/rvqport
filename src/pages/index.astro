---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import PictureRest from '../components/PictureRest.astro';
import Work from '../components/Work.astro';
import Experience from '../components/Experience.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/profile';
---

<Base
  title={`${profile.fullName} · ${profile.role}`}
  description={`${profile.fullName}, ${profile.role.toLowerCase()} in Hermosillo, Mexico. TypeScript, React, Next.js, Node.js and NestJS, from the first requirement to production.`}
>
  <main id="main">
    <Hero />
    <About />
    <PictureRest />
    <Work />
    <Experience />
    <Contact />
  </main>
  <Footer />
</Base>
