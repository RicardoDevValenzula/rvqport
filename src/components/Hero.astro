---
import { Image } from 'astro:assets';
import board from '../assets/photos/abner-board.jpg';
import LiveSlug from './LiveSlug.astro';
import { profile, mailto } from '../data/profile';
---

<section class="hero" aria-labelledby="hero-title">
  <h1 id="hero-title" class="name" translate="no">
    <span class="name__half name__half--first">{profile.firstName}</span>
    <span class="name__half name__half--last">{profile.lastName}</span>
    <span class="visually-hidden">Quintana, {profile.role.toLowerCase()}</span>
  </h1>

  <div class="panel">
    <div class="intro">
      <div class="intro__paper">
        <div class="intro__copy">
          <p class="intro__lead" data-reveal>{profile.lead}</p>
          <a class="button" href={mailto} data-reveal style="--i: 1">Email me <span aria-hidden="true">→</span></a>
        </div>
        <nav class="intro__nav" aria-label="Sections">
          <a class="link" href="#about">About</a>
          <a class="link" href="#work">Team work</a>
          <a class="link" href="#projects">My projects</a>
          <a class="link" href="#experience">Experience</a>
          <a class="link" href="#contact">Contact</a>
        </nav>
      </div>
      <div class="intro__photo duotone">
        <Image
          src={board}
          alt="A hand-wired circuit board from ABNER, the NSA's first in-house digital computer, held in an acrylic frame"
          widths={[480, 800, 1200]}
          sizes="(max-width: 720px) 100vw, 26vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>

  <div class="panel">
    <LiveSlug />
  </div>
</section>

<style>
  .hero {
    /* Height of one pinned strip: the word plus its edge margin */
    --strip: calc(var(--step-name) * 0.85 + 28px + 12px);
    position: relative;
  }

  .name {
    position: sticky;
    top: 0;
    z-index: 2;
    height: 100svh;
    display: grid;
    grid-template-rows: auto 1fr auto;
    pointer-events: none;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-name);
    line-height: 0.85;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    font-kerning: normal;
  }

  .name__half {
    display: block;
    background: var(--bg);
    white-space: nowrap;
  }

  .name__half--first {
    grid-row: 1;
    padding: 28px var(--edge) 12px;
  }

  .name__half--last {
    grid-row: 3;
    padding: 12px var(--edge) 28px;
    text-align: right;
  }

  /* Keep focused controls clear of the pinned name strips */
  .hero :focus-visible {
    scroll-margin-block: var(--strip);
  }

  .panel {
    height: 100svh;
    padding: var(--strip) var(--edge);
  }

  /* The first panel slides up under the pinned name, so the pin releases after two screens */
  .name + .panel {
    margin-top: -100svh;
  }

  .intro {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gutter);
    height: 100%;
  }

  .intro__paper {
    grid-column: 1 / span 9;
    position: relative;
    display: grid;
    grid-template-columns: repeat(9, minmax(0, 1fr));
    gap: var(--gutter);
    align-items: center;
    padding: clamp(24px, 3vw, 48px);
    background: var(--field-2);
    color: var(--field-2-ink);
  }

  .intro__copy {
    grid-column: 3 / span 5;
  }

  .intro__lead {
    font-size: var(--step-lead);
    line-height: 1.3;
    max-width: 30ch;
  }

  .intro__copy .button {
    margin-top: 32px;
  }

  .intro__nav {
    grid-column: 9;
    justify-self: end;
    display: grid;
    gap: 10px;
    font-size: var(--step-small);
    pointer-events: auto;
  }

  .intro__photo {
    grid-column: 10 / -1;
  }

  .intro__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The one moving picture: a slow scale as the stage scrolls away */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .intro__photo img {
        animation: drift linear both;
        animation-timeline: view();
        animation-range: cover 0% cover 100%;
      }
    }
  }

  @keyframes drift {
    from {
      transform: scale(1.12);
    }
    to {
      transform: scale(1);
    }
  }

  @media (max-width: 900px) {
    .intro__copy {
      grid-column: 1 / span 7;
    }

    .intro__nav {
      grid-column: 8 / -1;
    }
  }

  @media (max-width: 720px) {
    .hero {
      --strip: calc(var(--step-name) * 0.85 + 16px + 8px);
    }

    .name__half--first {
      padding: 16px var(--edge) 8px;
    }

    .name__half--last {
      padding: 8px var(--edge) 16px;
    }

    .panel {
      height: auto;
      min-height: 100svh;
    }

    .intro {
      display: flex;
      flex-direction: column-reverse;
      gap: 0;
    }

    .intro__paper {
      display: block;
      padding: 20px;
    }

    .intro__photo {
      height: 40svh;
    }

    .intro__nav {
      display: flex;
      flex-wrap: wrap;
      gap: 4px 20px;
      margin-top: 24px;
      font-size: var(--step-body);
    }

    .intro__nav a {
      padding-block: 10px;
    }
  }
</style>
