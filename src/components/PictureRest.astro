---
import { Image } from 'astro:assets';
import card from '../assets/photos/punch-card.png';
---

<figure class="rest" aria-labelledby="rest-caption">
  <div class="rest__pair">
    <div class="rest__frame rest__frame--card duotone" data-reveal>
      <Image
        src={card}
        alt="An unpunched IBM 80-column card, every column printed with the digits 0 to 9"
        widths={[800, 1280]}
        sizes="(max-width: 720px) 100vw, 58vw"
      />
    </div>
    <div class="rest__frame rest__frame--clip duotone" data-reveal style="--i: 1">
      <video
        id="teletype"
        src="/media/teletype-explorer-1.webm"
        poster="/media/teletype-explorer-1-poster.jpg"
        width="640"
        height="360"
        muted
        loop
        playsinline
        preload="metadata"
        aria-label="A teletype printing the countdown and liftoff reports of Explorer 1: 5, 4, 3, 2, 1, mainstage, liftoff, exhaust flame looks good, still going"
      ></video>
    </div>
  </div>
  <figcaption id="rest-caption">
    Programs used to be decks of 80-column cards. In 1958 a teletype printed Explorer 1’s launch line by line:
    liftoff, exhaust flame looks good, still going. The first deploy log.
  </figcaption>
</figure>

<script>
  // Decorative loop: plays only while visible, never under reduced motion.
  const video = document.querySelector<HTMLVideoElement>('#teletype');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (video && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting && !reduce.matches) video.play().catch(() => {});
      else video.pause();
    });
    observer.observe(video);
  }
</script>

<style>
  .rest {
    padding: 0 var(--edge) var(--section-gap);
    background: var(--field-2);
    color: var(--field-2-ink);
  }

  .rest__pair {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gutter);
  }

  .rest__frame--card {
    grid-column: 1 / span 7;
    aspect-ratio: 16 / 9;
  }

  .rest__frame--clip {
    grid-column: 8 / -1;
  }

  .rest img,
  .rest video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rest video {
    filter: grayscale(1) contrast(1.15) brightness(1.05);
    mix-blend-mode: multiply;
  }

  figcaption {
    margin-top: 16px;
    max-width: 44ch;
    font-size: var(--step-small);
    color: var(--field-2-muted);
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .rest__frame--card img {
        animation: rest-drift linear both;
        animation-timeline: view();
        animation-range: entry 0% exit 100%;
      }
    }
  }

  @keyframes rest-drift {
    from {
      transform: scale(1.08) translateX(-2%);
    }
    to {
      transform: scale(1.08) translateX(2%);
    }
  }

  @media (max-width: 720px) {
    .rest__pair {
      grid-template-columns: 1fr;
    }

    .rest__frame--card,
    .rest__frame--clip {
      grid-column: 1;
    }

    .rest__frame--clip {
      aspect-ratio: 16 / 9;
    }
  }
</style>
