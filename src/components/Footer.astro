---
import { profile } from '../data/profile';

const words = profile.fullName.toUpperCase().split(' ');
const year = new Date().getFullYear();

// Unbounded 800 caps advance about 0.9em; cap height about 0.74em.
// Size each line so its natural width is close to the viewBox width,
// so textLength only corrects the last few percent instead of distorting.
const fit = (text: string) => {
  const size = Math.round(1000 / (text.length * 0.9));
  const height = Math.round(size * 0.74);
  return { size, height };
};
const line = fit(words.join(' '));
---

<footer class="footer">
  <div class="footer__cols">
    <div>
      <p class="footer__head">Contact</p>
      <a class="link" href={`mailto:${profile.email}`}>{profile.email}</a>
    </div>
    <nav aria-label="Footer">
      <p class="footer__head">Sections</p>
      <ul>
        <li><a class="link" href="#about">About</a></li>
        <li><a class="link" href="#projects">My projects</a></li>
        <li><a class="link" href="#work">Team work</a></li>
        <li><a class="link" href="#experience">Experience</a></li>
        <li><a class="link" href="#contact">Contact</a></li>
      </ul>
    </nav>
    <div>
      <p class="footer__head">Elsewhere</p>
      <ul>
        <li><a class="link" href={profile.links.github.href}>GitHub</a></li>
        <li><a class="link" href={profile.links.linkedin.href}>LinkedIn</a></li>
      </ul>
    </div>
    <div>
      <p class="footer__head">Photographs</p>
      <p class="footer__soft">
        ABNER circuit board by Daderot, IBM card by MdeVicente, Robotron terminal by Wolfgang Stief (CC0). Explorer 1
        teletype footage, public domain. All via Wikimedia Commons; duotone applied.
      </p>
    </div>
  </div>

  <div class="footer__mark" translate="no">
    <svg class="mark mark--line" viewBox={`0 0 1000 ${line.height}`} role="img" aria-label={profile.fullName}>
      <text x="0" y={line.height} font-size={line.size} textLength="1000" lengthAdjust="spacingAndGlyphs">
        {words.join(' ')}
      </text>
    </svg>
    <div class="mark--stack" aria-hidden="true">
      {
        words.map((word) => {
          const { size, height } = fit(word);
          return (
            <svg class="mark" viewBox={`0 0 1000 ${height}`}>
              <text x="0" y={height} font-size={size} textLength="1000" lengthAdjust="spacingAndGlyphs">
                {word}
              </text>
            </svg>
          );
        })
      }
    </div>
    <p class="footer__legal">© {year} {profile.fullName}.</p>
  </div>
</footer>

<style>
  .footer {
    display: grid;
    grid-template-rows: auto auto;
    row-gap: clamp(120px, 16vw, 240px);
    padding: 40px var(--edge) 20px;
    background: var(--field-2);
    color: var(--field-2-ink);
    font-size: 16px;
  }

  .footer__cols {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gutter);
  }

  .footer__cols > * {
    min-width: 0;
  }

  .footer__cols a {
    overflow-wrap: anywhere;
  }

  .footer__head {
    margin-bottom: 8px;
    font-weight: 500;
  }

  .footer ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 4px;
  }

  .footer__soft {
    color: var(--field-2-muted);
    max-width: 30ch;
  }

  .mark {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .mark text {
    font-family: var(--font-display);
    font-weight: 800;
    fill: currentColor;
  }

  .mark--stack {
    display: none;
  }

  .footer__legal {
    margin-top: 20px;
    font-size: var(--step-small);
    color: var(--field-2-muted);
  }

  @media (max-width: 720px) {
    .footer__cols {
      grid-template-columns: 1fr 1fr;
      row-gap: 32px;
    }

    .mark--line {
      display: none;
    }

    .mark--stack {
      display: grid;
      gap: 6px;
    }
  }
</style>
